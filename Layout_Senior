Private Function ObterPastaLocal(wb As Workbook) As String
    Dim sep As String: sep = Application.PathSeparator
    Dim caminho As String
    caminho = wb.Path
    If Len(caminho) > 0 And Left(caminho, 4) <> "http" Then
        If Right(caminho, 1) <> sep Then caminho = caminho & sep
        ObterPastaLocal = caminho: Exit Function
    End If
    Dim fullName As String: fullName = wb.fullName
    If Len(fullName) > 0 And Left(fullName, 4) <> "http" Then
        caminho = Left(fullName, InStrRev(fullName, sep))
        If Len(caminho) > 0 Then ObterPastaLocal = caminho: Exit Function
    End If
    Dim oneDriveLocal As String
    oneDriveLocal = Environ("OneDrive")
    If Len(oneDriveLocal) = 0 Then oneDriveLocal = Environ("OneDriveConsumer")
    If Len(oneDriveLocal) = 0 Then oneDriveLocal = Environ("OneDriveCommercial")
    If Len(oneDriveLocal) > 0 And Len(fullName) > 0 Then
        Dim urlPath As String: urlPath = fullName
        Dim posSlash As Integer: posSlash = InStr(9, urlPath, "/")
        If posSlash > 0 Then
            urlPath = Mid(urlPath, posSlash)
            urlPath = Mid(urlPath, InStr(2, urlPath, "/"))
            urlPath = Replace(urlPath, "/", sep)
            Dim posUlt As Integer: posUlt = InStrRev(urlPath, sep)
            If posUlt > 0 Then urlPath = Left(urlPath, posUlt)
            caminho = oneDriveLocal & urlPath
            If Dir(caminho, vbDirectory) <> "" Then
                ObterPastaLocal = caminho: Exit Function
            End If
        End If
    End If
    ObterPastaLocal = ""
End Function

Private Function EhAbaTabela(nome As String) As Boolean
    Dim nl As String: nl = LCase(nome)
    EhAbaTabela = (InStr(nl, "tabela") > 0 Or InStr(nl, "tabelas") > 0)
    If LCase(nome) = LCase(ABA_CONFIG) Then EhAbaTabela = False
    If LCase(nome) = "vba history" Then EhAbaTabela = False
    If LCase(nome) = "claude log" Then EhAbaTabela = False
End Function

Private Function EhCodigoProduto(valor As Variant) As Boolean
    EhCodigoProduto = False
    If IsEmpty(valor) Or IsNull(valor) Then Exit Function
    Dim s As String: s = Trim(CStr(valor))
    If Not IsNumeric(s) Then Exit Function
    EhCodigoProduto = (Len(s) >= COD_MIN_DIGITS And Len(s) <= COD_MAX_DIGITS)
End Function

Private Function EhPrecoValido(valor As Variant) As Boolean
    EhPrecoValido = False
    If IsEmpty(valor) Or IsNull(valor) Then Exit Function
    Dim s As String: s = Trim(CStr(valor))
    If s = "" Then Exit Function
    If Not IsNumeric(s) Then Exit Function
    If CDbl(s) <= 0 Then Exit Function
    EhPrecoValido = True
End Function

Private Function ExtrairCodigoTabela(nomeAba As String, wsConfig As Worksheet) As String
    Dim partes() As String, cod As String, nomeST As String
    nomeST = Trim(Mid(nomeAba, InStr(LCase(nomeAba), "tabela") + 6))
    partes = Split(nomeST, " ")
    If UBound(partes) >= 0 Then
        If partes(0) Like "####" Or IsNumeric(partes(0)) Then cod = partes(0)
    End If
    If cod = "" Then
        cod = LerConfigTabela(wsConfig, nomeAba, "CODIGO_TABELA")
        If cod = "" Then
            cod = InputBox("Codigo nao identificado para:" & vbCrLf & _
                           Chr(34) & nomeAba & Chr(34) & vbCrLf & vbCrLf & _
                           "Informe o codigo (ex: 0016):", "Codigo da Tabela", "")
            If cod <> "" Then SalvarConfigTabela wsConfig, nomeAba, "CODIGO_TABELA", cod
        End If
    End If
    ExtrairCodigoTabela = cod
End Function

Private Function ObterColunaCodigoProduto(codigoTabela As String, nomeAba As String, _
                                           ws As Worksheet, wsConfig As Worksheet) As Long
    If InStr(COD_COLUNA_B, "|" & codigoTabela & "|") > 0 Then
        ObterColunaCodigoProduto = 2: Exit Function
    End If
    Dim colSalva As String: colSalva = LerConfigTabela(wsConfig, nomeAba, "COLUNA_CODIGO")
    If colSalva <> "" Then ObterColunaCodigoProduto = CLng(colSalva): Exit Function
    Dim resp As String
    resp = InputBox("Tabela " & Chr(34) & nomeAba & Chr(34) & vbCrLf & _
                    "Letra da coluna do codigo do produto? (Padrao = C)", "Coluna do Codigo", "C")
    If resp = "" Then resp = "C"
    resp = UCase(Trim(resp))
    Dim nc As Long: nc = Range(resp & "1").Column
    SalvarConfigTabela wsConfig, nomeAba, "COLUNA_CODIGO", CStr(nc)
    ObterColunaCodigoProduto = nc
End Function

Private Function IdentificarColunasPreco(ws As Worksheet) As Variant
    Dim res() As String, cnt As Long, c As Long
    Dim lastCol As Long, h3 As String, h5 As String, grupo As String, nome As String
    lastCol = ws.UsedRange.Columns.Count + ws.UsedRange.Column - 1
    cnt = 0: grupo = "": ReDim res(0 To 50)
    For c = 6 To lastCol
        h3 = Trim(CStr(ws.Cells(3, c).Value))
        h5 = Trim(CStr(ws.Cells(5, c).Value))
        If h3 <> "" Then grupo = h3
        Dim h5l As String: h5l = LCase(h5)
        If h5l = "cx" Or h5l = "pct" Or h5l = "preco" Or _
           (h5l <> "" And h5l <> "qt" And h5l <> "descricao" And _
            h5l <> "cod" And h5l <> "%") Then
            nome = grupo: If nome = "" Then nome = "PRECO"
            If h5l = "cx" Or h5l = "pct" Then nome = nome & " - " & UCase(h5)
            res(cnt) = nome & "|" & c: cnt = cnt + 1
        End If
    Next c
    If cnt = 0 Then res(0) = "PRECO|6": cnt = 1
    ReDim Preserve res(0 To cnt - 1)
    IdentificarColunasPreco = res
End Function

Private Function EscolherColunaPreco(colunasPreco As Variant, nomeAba As String, _
                                      wsConfig As Worksheet) As Long
    Dim colSalva As String: colSalva = LerConfigTabela(wsConfig, nomeAba, "COLUNA_PRECO")
    Dim opts As String, i As Long, p() As String
    opts = "Tabela: " & nomeAba & vbCrLf & vbCrLf & "Selecione o numero do preco:" & vbCrLf & vbCrLf
    For i = 0 To UBound(colunasPreco)
        p = Split(colunasPreco(i), "|")
        opts = opts & (i + 1) & " - " & p(0) & vbCrLf
    Next i
    Dim sug As String: sug = "1"
    If colSalva <> "" Then
        For i = 0 To UBound(colunasPreco)
            p = Split(colunasPreco(i), "|")
            If p(1) = colSalva Then sug = CStr(i + 1)
        Next i
    End If
    Dim resp As String: resp = InputBox(opts, "Selecionar Preco - " & nomeAba, sug)
    If resp = "" Or Not IsNumeric(resp) Then
        EscolherColunaPreco = CLng(Split(colunasPreco(0), "|")(1)): Exit Function
    End If
    Dim idx As Long: idx = CInt(resp) - 1
    If idx < 0 Or idx > UBound(colunasPreco) Then idx = 0
    Dim pe() As String: pe = Split(colunasPreco(idx), "|")
    Dim col As Long: col = CLng(pe(1))
    SalvarConfigTabela wsConfig, nomeAba, "COLUNA_PRECO", CStr(col)
    EscolherColunaPreco = col
End Function

Private Sub ProcessarAba(ws As Worksheet, wsConfig As Worksheet, _
                          dataInicial As String, pastaDestino As String, _
                          tolMenor As String, tolMaior As String)
    Dim codTab As String, colCod As Long, colPreco As Long
    Dim colsPreco As Variant, lastRow As Long, r As Long
    Dim codProd As Variant, valPreco As Variant, precoFmt As String
    Dim csvTxt As String, nomeArq As String, fn As Integer, cnt As Long

    codTab = ExtrairCodigoTabela(ws.Name, wsConfig)
    If codTab = "" Then MsgBox "Aba " & Chr(34) & ws.Name & Chr(34) & " ignorada.", vbInformation: Exit Sub

    colCod = ObterColunaCodigoProduto(codTab, ws.Name, ws, wsConfig)
    colsPreco = IdentificarColunasPreco(ws)
    If UBound(colsPreco) = 0 Then
        colPreco = CLng(Split(colsPreco(0), "|")(1))
    Else
        colPreco = EscolherColunaPreco(colsPreco, ws.Name, wsConfig)
    End If

    lastRow = ws.UsedRange.row + ws.UsedRange.Rows.Count - 1
    csvTxt = "1;" & codTab & vbCrLf
    cnt = 0

    For r = 6 To lastRow
        codProd = ws.Cells(r, colCod).Value
        If Not EhCodigoProduto(codProd) Then GoTo Skip
        valPreco = ws.Cells(r, colPreco).Value
        If Not EhPrecoValido(valPreco) Then GoTo Skip
        precoFmt = Replace(Format(CDbl(Trim(CStr(valPreco))), "0.00"), ".", ",")
        csvTxt = csvTxt & "2;" & dataInicial & ";" & Trim(CStr(codProd)) & ";U;" & _
                 precoFmt & ";" & tolMenor & ";" & tolMaior & ";A;9.999.999,00" & vbCrLf
        cnt = cnt + 1
Skip:
    Next r

    If cnt = 0 Then MsgBox "Aba " & Chr(34) & ws.Name & Chr(34) & ": sem produtos.", vbInformation: Exit Sub

    nomeArq = pastaDestino & "tabela_" & codTab & ".csv"
    fn = FreeFile
    Open nomeArq For Output As #fn
    Print #fn, Left(csvTxt, Len(csvTxt) - 2)
    Close #fn
    Debug.Print "OK: " & nomeArq & " (" & cnt & " produtos)"
End Sub

Private Function ObterOuCriarAbaConfig(wb As Workbook) As Worksheet
    Dim ws As Worksheet
    On Error Resume Next: Set ws = wb.Worksheets(ABA_CONFIG): On Error GoTo 0
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = ABA_CONFIG: ws.Visible = xlSheetVeryHidden
        ws.Cells(1, 1).Value = "NomeAba"
        ws.Cells(1, 2).Value = "Chave"
        ws.Cells(1, 3).Value = "Valor"
    End If
    Set ObterOuCriarAbaConfig = ws
End Function

Private Function LerConfigTabela(wsConfig As Worksheet, nomeAba As String, chave As String) As String
    Dim lr As Long, i As Long
    lr = wsConfig.UsedRange.row + wsConfig.UsedRange.Rows.Count - 1
    For i = 2 To lr
        If wsConfig.Cells(i, 1).Value = nomeAba And wsConfig.Cells(i, 2).Value = chave Then
            LerConfigTabela = CStr(wsConfig.Cells(i, 3).Value): Exit Function
        End If
    Next i
    LerConfigTabela = ""
End Function

Private Sub SalvarConfigTabela(wsConfig As Worksheet, nomeAba As String, chave As String, valor As String)
    Dim lr As Long, i As Long
    lr = wsConfig.UsedRange.row + wsConfig.UsedRange.Rows.Count - 1
    For i = 2 To lr
        If wsConfig.Cells(i, 1).Value = nomeAba And wsConfig.Cells(i, 2).Value = chave Then
            wsConfig.Cells(i, 3).Value = valor: Exit Sub
        End If
    Next i
    wsConfig.Cells(lr + 1, 1).Value = nomeAba
    wsConfig.Cells(lr + 1, 2).Value = chave
    wsConfig.Cells(lr + 1, 3).Value = valor
End Sub

