' MODULO: ExportarTabelasPreco  |  VERSAO: 3.1  |  DATA: 29/04/2026
' CORRECAO v3.0:
'   - ListBox vazio: ctrl.AddItem no Designer perde os itens ao instanciar.
'   - Solucao: nomes das abas passados via g_NomesAbas (global) e carregados
'     no UserForm_Initialize, que roda apos a instanciacao do formulario.
' NOVO v3.1:
'   - Solicita % de TOLERANCIA MENOR e % de TOLERANCIA MAIOR via InputBox
'     antes da exportacao. Valores sao incluidos na linha CSV apos o preco
'     e antes do bloco ";A;9.999.999,00".
'==============================================================================
Option Explicit

Private Const COD_COLUNA_B  As String = "|0016|"
Private Const ABA_CONFIG     As String = "Config_Export"
Private Const PASTA_EXPORT   As String = "Importacao"
Private Const COD_MIN_DIGITS As Integer = 7
Private Const COD_MAX_DIGITS As Integer = 8

Public g_Selecionadas() As String
Public g_SelCnt         As Long
Public g_Cancelado      As Boolean
Public g_NomesAbas()    As String   ' << NOVO: passa nomes para o Initialize
Public g_NomesCnt       As Long     ' << NOVO: quantidade de nomes

Public Sub ReceberSelecao(sel() As String, k As Long)
    g_Selecionadas = sel
    g_SelCnt = k
    g_Cancelado = False
End Sub

Public Sub ExportarTabelas()
    Dim wb As Workbook, ws As Worksheet, wsConfig As Worksheet
    Dim pastaDestino As String, i As Long
    Dim tabelasProcessadas As Long, erros As String
    Set wb = ThisWorkbook

    Dim nomes() As String, cnt As Long
    cnt = 0
    ReDim nomes(0 To wb.Worksheets.Count - 1)
    For Each ws In wb.Worksheets
        If EhAbaTabela(ws.Name) Then
            nomes(cnt) = ws.Name
            cnt = cnt + 1
        End If
    Next ws
    If cnt = 0 Then MsgBox "Nenhuma aba TABELA encontrada.", vbInformation: Exit Sub
    ReDim Preserve nomes(0 To cnt - 1)

    Dim dataInicial As String
    dataInicial = InputBox("Informe a DATA INICIAL para exportacao:" & vbCrLf & _
                           "(formato: DD/MM/AAAA)", "Data Inicial", Format(Date, "DD/MM/YYYY"))
    If dataInicial = "" Then MsgBox "Exportacao cancelada.", vbInformation: Exit Sub
    If Not IsDate(dataInicial) Then MsgBox "Data invalida. Use DD/MM/AAAA.", vbExclamation: Exit Sub
    dataInicial = Format(CDate(dataInicial), "DD/MM/YYYY")

    Dim tolMenor As String, tolMaior As String, tolNum As Double
    tolMenor = InputBox("Informe o % de TOLERANCIA MENOR:" & vbCrLf & _
                        "(use virgula como separador decimal, ex: 30,00)", _
                        "Tolerancia Menor", "0,00")
    If tolMenor = "" Then MsgBox "Exportacao cancelada.", vbInformation: Exit Sub
    If Not IsNumeric(tolMenor) Then
        MsgBox "Tolerancia menor invalida. Use formato numerico (ex: 30,00).", vbExclamation: Exit Sub
    End If
    tolNum = CDbl(tolMenor)
    tolMenor = Replace(Format(tolNum, "0.00"), ".", ",")

    tolMaior = InputBox("Informe o % de TOLERANCIA MAIOR:" & vbCrLf & _
                        "(use virgula como separador decimal, ex: 40,00)", _
                        "Tolerancia Maior", "0,00")
    If tolMaior = "" Then MsgBox "Exportacao cancelada.", vbInformation: Exit Sub
    If Not IsNumeric(tolMaior) Then
        MsgBox "Tolerancia maior invalida. Use formato numerico (ex: 40,00).", vbExclamation: Exit Sub
    End If
    tolNum = CDbl(tolMaior)
    tolMaior = Replace(Format(tolNum, "0.00"), ".", ",")

    g_Cancelado = True
    g_SelCnt = 0
    ReDim g_Selecionadas(0)

    ' Passa nomes para as globais antes de abrir o form
    g_NomesAbas = nomes
    g_NomesCnt = cnt

    MostrarSeletorDinamico cnt

    If g_Cancelado Or g_SelCnt = 0 Then
        MsgBox "Exportacao cancelada.", vbInformation: Exit Sub
    End If

    pastaDestino = ObterPastaLocal(wb)
    If pastaDestino = "" Then
        MsgBox "Nao foi possivel determinar a pasta do arquivo." & vbCrLf & _
               "Verifique se o arquivo esta sincronizado localmente.", vbExclamation
        Exit Sub
    End If
    pastaDestino = pastaDestino & PASTA_EXPORT & Application.PathSeparator
    If Dir(pastaDestino, vbDirectory) = "" Then
        MkDir Left(pastaDestino, Len(pastaDestino) - 1)
    End If

    Set wsConfig = ObterOuCriarAbaConfig(wb)
    tabelasProcessadas = 0: erros = ""

    For i = 0 To g_SelCnt - 1
        Dim nomeAba As String: nomeAba = g_Selecionadas(i)
        If nomeAba = "" Then GoTo ProxSel
        On Error GoTo ErroAba
        Set ws = wb.Worksheets(nomeAba)
        ProcessarAba ws, wsConfig, dataInicial, pastaDestino, tolMenor, tolMaior
        tabelasProcessadas = tabelasProcessadas + 1
        GoTo ProxSel
ErroAba:
        erros = erros & vbCrLf & "- " & nomeAba & ": " & Err.Description
        Err.Clear: Resume ProxSel
ProxSel:
    Next i

    Dim msg As String
    msg = "Exportacao concluida!" & vbCrLf & vbCrLf & _
          "Tabelas exportadas: " & tabelasProcessadas & vbCrLf & vbCrLf & _
          "Arquivos salvos em:" & vbCrLf & pastaDestino
    If erros <> "" Then msg = msg & vbCrLf & vbCrLf & "Erros:" & erros
    MsgBox msg, vbInformation, "Exportacao de Tabelas"
End Sub

