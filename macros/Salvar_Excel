' Nome da aba auxiliar usada para a seleção das abas a exportar.
' Mantida como constante para facilitar manutenção e evitar colisões.
Public Const NOME_ABA_SELECAO As String = "_Selecao_Exportacao"

' Esta macro funciona em DUAS execuções:
'   1ª execução: varre TODAS as abas do arquivo cujo nome contém "Tabela"
'                e cria a aba auxiliar listando-as. O usuário marca com "X"
'                na coluna A as abas que deseja exportar.
'   2ª execução: lê os "X" da aba auxiliar, exporta as abas marcadas e
'                remove a aba auxiliar.
'
' A fonte da lista é o próprio workbook (ThisWorkbook.Worksheets), e não
' a aba "Sumário". Assim, qualquer aba que contenha "Tabela" no nome fica
' disponível para exportação, independentemente do Sumário.
Sub SELECIONAR_ABAS_E_SALVAR()
    Dim ws As Worksheet
    Dim selecao As Worksheet
    Dim selecionadas As Object
    Dim i As Long

    ' Verifica se a aba auxiliar de seleção já existe
    On Error Resume Next
    Set selecao = ThisWorkbook.Sheets(NOME_ABA_SELECAO)
    On Error GoTo 0

    If selecao Is Nothing Then
        ' --------------------------------------------------------------
        ' 1ª EXECUÇÃO: criar a aba auxiliar com todas as abas "Tabela*"
        ' --------------------------------------------------------------
        Call CriarAbaSelecao
        Exit Sub
    End If

    ' ------------------------------------------------------------------
    ' 2ª EXECUÇÃO: ler os "X" e exportar as abas marcadas
    ' ------------------------------------------------------------------
    Set selecionadas = CreateObject("Scripting.Dictionary")

    Dim ultimaLinha As Long
    ultimaLinha = selecao.Cells(selecao.Rows.Count, 2).End(xlUp).row

    For i = 4 To ultimaLinha
        If UCase(Trim(CStr(selecao.Cells(i, 1).Value))) = "X" Then
            Dim nomeAba As String
            nomeAba = Trim(CStr(selecao.Cells(i, 2).Value))
            If nomeAba <> "" And Not selecionadas.Exists(nomeAba) Then
                selecionadas.Add nomeAba, True
            End If
        End If
    Next i

    If selecionadas.Count = 0 Then
        MsgBox "Nenhuma aba foi marcada com 'X' na coluna A da aba '" & _
               NOME_ABA_SELECAO & "'." & vbCrLf & vbCrLf & _
               "Marque as abas desejadas e execute a macro novamente." & vbCrLf & _
               "Para recriar a lista, exclua a aba '" & NOME_ABA_SELECAO & _
               "' e execute a macro.", _
               vbExclamation, "Nada a exportar"
        Exit Sub
    End If

    ' Exportar cada aba marcada
    Dim exportadas As Long
    exportadas = 0
    For Each ws In ThisWorkbook.Sheets
        If selecionadas.Exists(ws.Name) Then
            Call Salvar_Excel(ws)
            exportadas = exportadas + 1
        End If
    Next ws

    ' Remove a aba auxiliar após a exportação
    Application.DisplayAlerts = False
    selecao.Delete
    Application.DisplayAlerts = True

    MsgBox exportadas & " aba(s) exportada(s) com sucesso.", _
           vbInformation, "Concluído"
End Sub

' Cria a aba auxiliar listando todas as abas do arquivo cujo nome contém
' "Tabela". A lista é ordenada pelo número extraído do nome (quando aplicável).
Private Sub CriarAbaSelecao()
    Dim ws As Worksheet
    Dim selecao As Worksheet
    Dim AbaNomes() As String
    Dim NumTabelas() As Long
    Dim total As Long
    Dim i As Long, j As Long

    ' Coleta todas as abas que contêm "Tabela" no nome
    total = 0
    ReDim AbaNomes(1 To ThisWorkbook.Worksheets.Count)
    ReDim NumTabelas(1 To ThisWorkbook.Worksheets.Count)

    For Each ws In ThisWorkbook.Worksheets
        If InStr(1, ws.Name, "Tabela", vbTextCompare) > 0 Then
            total = total + 1
            AbaNomes(total) = ws.Name
            ' Mantém compatibilidade com a ordenação anterior (Mid(name, 8, 4))
            If Len(ws.Name) >= 11 Then
                NumTabelas(total) = Val(Mid(ws.Name, 8, 4))
            Else
                NumTabelas(total) = 0
            End If
        End If
    Next ws

    If total = 0 Then
        MsgBox "Nenhuma aba contendo a palavra 'Tabela' foi encontrada neste arquivo.", _
               vbInformation, "Nenhuma Aba Encontrada"
        Exit Sub
    End If

    ' Ordena por número da tabela (bubble sort simples; lista pequena)
    For i = 1 To total - 1
        For j = i + 1 To total
            If NumTabelas(i) > NumTabelas(j) Or _
               (NumTabelas(i) = NumTabelas(j) And StrComp(AbaNomes(i), AbaNomes(j), vbTextCompare) > 0) Then
                Dim tmpNum As Long
                Dim tmpNome As String
                tmpNum = NumTabelas(i) : NumTabelas(i) = NumTabelas(j) : NumTabelas(j) = tmpNum
                tmpNome = AbaNomes(i) : AbaNomes(i) = AbaNomes(j) : AbaNomes(j) = tmpNome
            End If
        Next j
    Next i

    ' Cria a aba auxiliar
    Application.ScreenUpdating = False
    Set selecao = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    selecao.Name = NOME_ABA_SELECAO

    With selecao
        .Range("A1").Value = "Marque com 'X' na coluna A as abas que deseja exportar e execute a macro novamente."
        .Range("A1").Font.Bold = True
        .Range("A1:D1").Merge

        .Range("A3").Value = "Marcar (X)"
        .Range("B3").Value = "Nome da Aba"
        .Range("A3:B3").Font.Bold = True
        .Range("A3:B3").Interior.Color = RGB(220, 230, 241)

        For i = 1 To total
            .Cells(i + 3, 2).Value = AbaNomes(i)
        Next i

        .Columns("A").ColumnWidth = 12
        .Columns("B").AutoFit
        .Range("A4").Select
    End With

    selecao.Activate
    Application.ScreenUpdating = True

    MsgBox total & " aba(s) com 'Tabela' no nome foram listadas." & vbCrLf & vbCrLf & _
           "1) Marque com 'X' na coluna A as abas que deseja exportar." & vbCrLf & _
           "2) Execute a macro novamente para gerar os arquivos .xlsx.", _
           vbInformation, "Seleção de Abas"
End Sub

Function SheetExists(SheetName As String) As Boolean
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = ThisWorkbook.Sheets(SheetName)
    SheetExists = Not ws Is Nothing
    Set ws = Nothing
    On Error GoTo 0
End Function


Sub QuickSort(arr As Variant, first As Long, last As Long)
    Dim pivot As Variant, i As Long, j As Long, temp As Variant
    If first >= last Then Exit Sub
    pivot = arr((first + last) \ 2)
    i = first
    j = last
    Do
        Do While arr(i) < pivot: i = i + 1: Loop
        Do While arr(j) > pivot: j = j - 1: Loop
        If i <= j Then
            temp = arr(i)
            arr(i) = arr(j)
            arr(j) = temp
            i = i + 1
            j = j - 1
        End If
    Loop While i <= j
    Call QuickSort(arr, first, j)
    Call QuickSort(arr, i, last)
End Sub


Sub Salvar_Excel(ws As Worksheet)
    Dim Pasta As Object
    Dim CaminhoBase As String
    Dim PastaDaTabela As String ' <<< ALTERAÇÃO: Nova variável para a pasta da tabela
    Dim NomeBaseTabela As String ' <<< ALTERAÇÃO: Nova variável para o nome limpo
    Dim NomeArquivoFinal As String ' <<< ALTERAÇÃO: Nova variável para o nome do arquivo com data
    Dim CaminhoCompleto As String
    Dim NovoWB As Workbook
    Dim wsDestino As Worksheet
    Dim wbAberto As Workbook
    Dim intervalo As Range

    ' <<< ALTERAÇÃO: Validação inicial e definição do nome base a partir de C1
    ' Usamos a função para remover caracteres inválidos que podem quebrar a criação de pastas/arquivos.
    NomeBaseTabela = RemoverCaracteresInvalidos(Trim(ws.Range("C1").Value))
    If NomeBaseTabela = "" Then
        MsgBox "Erro: A célula C1 está vazia na aba '" & ws.Name & "'. A planilha não foi salva.", vbExclamation, "Operação Cancelada"
        Exit Sub
    End If
    
    ' Criar objeto para manipular pastas
    Set Pasta = CreateObject("scripting.FileSystemObject")
    
    ' <<< ALTERAÇÃO: Lógica de criação de pastas e arquivos
    ' 1. Define a pasta principal "TABELAS_EXCEL"
    CaminhoBase = ThisWorkbook.Path & "\" & "TABELAS_EXCEL"
    If Not Pasta.FolderExists(CaminhoBase) Then
        Pasta.CreateFolder CaminhoBase
    End If
    
    ' 2. Define e cria a subpasta com o nome da tabela
    PastaDaTabela = CaminhoBase & "\" & NomeBaseTabela
    If Not Pasta.FolderExists(PastaDaTabela) Then
        Pasta.CreateFolder PastaDaTabela
    End If
    
    ' 3. Define o nome final do arquivo (com data) e o caminho completo
    NomeArquivoFinal = NomeBaseTabela & "_" & Format(Date, "yyyy-mm-dd") & ".xlsx"
    CaminhoCompleto = PastaDaTabela & "\" & NomeArquivoFinal
    
    ' Verificar se o arquivo está aberto e fechá-lo se necessário
    On Error Resume Next
    ' <<< ALTERAÇÃO: Usa o novo nome de arquivo final para verificar
    Set wbAberto = Workbooks(NomeArquivoFinal)
    If Not wbAberto Is Nothing Then
        wbAberto.Close SaveChanges:=False
    End If
    On Error GoTo 0
    
    ' Verificar se o arquivo já existe e tentar apagá-lo (para garantir a substituição)
    If Dir(CaminhoCompleto) <> "" Then
        On Error Resume Next
        Kill CaminhoCompleto
        If Err.Number <> 0 Then
            MsgBox "Não foi possível substituir o arquivo existente: " & vbCrLf & CaminhoCompleto & vbCrLf & "Ele pode estar em uso ou você não tem permissão.", vbExclamation, "Erro ao Salvar"
            Exit Sub
        End If
        On Error GoTo 0
    End If

    ' Desativar atualizações da tela e alertas
    Application.ScreenUpdating = False
    
    ' --- O restante do seu código para copiar, colar valores e quebrar vínculos permanece o mesmo ---
    
    ' Criar novo arquivo e copiar a planilha específica
    Set NovoWB = Workbooks.Add(xlWBATWorksheet)
    ws.Copy After:=NovoWB.Sheets(NovoWB.Sheets.Count)
    
    ' Definir a planilha copiada
    Set wsDestino = NovoWB.Sheets(NovoWB.Sheets.Count)
    
    ' Remover a planilha extra criada pelo Workbooks.Add
    Application.DisplayAlerts = False
    NovoWB.Sheets(1).Delete
    Application.DisplayAlerts = True
    
    ' Definir intervalo entre as colunas C e P, da linha 7 até a última linha preenchida
    ' Corrigido para garantir que a última linha seja da planilha de origem (ws)
    On Error Resume Next
    Set intervalo = ws.Range("C7:P" & ws.Cells(ws.Rows.Count, "C").End(xlUp).row)
    On Error GoTo 0

    If Not intervalo Is Nothing Then
        ' Copiar o intervalo
        intervalo.Copy
        
        ' Colar os valores na nova planilha (convertendo fórmulas para valores)
        wsDestino.Range("C7").PasteSpecial Paste:=xlPasteValues
        Application.CutCopyMode = False ' Limpa a área de transferência
    End If

    ' Quebrar os vínculos existentes
    Dim myLinks As Variant
    myLinks = NovoWB.LinkSources(Type:=xlLinkTypeExcelLinks)
    If Not IsEmpty(myLinks) Then
        Dim linkIndex As Integer
        For linkIndex = 1 To UBound(myLinks)
            NovoWB.BreakLink Name:=myLinks(linkIndex), Type:=xlLinkTypeExcelLinks
        Next linkIndex
    End If

    ' Salvar o novo arquivo sem perguntar sobre substituição
    Application.DisplayAlerts = False
    NovoWB.SaveAs Filename:=CaminhoCompleto, FileFormat:=xlOpenXMLWorkbook
    Application.DisplayAlerts = True

    ' Fechar e limpar
    NovoWB.Close SaveChanges:=False

    ' Restaurar configurações
    Application.ScreenUpdating = True
    
End Sub

' --- FUNÇÃO AUXILIAR ---
' Certifique-se de que esta função também está no seu módulo
' para que a macro Salvar_Excel funcione corretamente.
Function RemoverCaracteresInvalidos(nome As String) As String
    Dim i As Integer
    Dim CaracteresInvalidos As String
    CaracteresInvalidos = "\/:*?""<>|"

    For i = 1 To Len(CaracteresInvalidos)
        nome = Replace(nome, Mid(CaracteresInvalidos, i, 1), "_")
    Next i
    
    RemoverCaracteresInvalidos = Trim(nome)
End Function
